; World Frontier - global strategy + 3D battlefield
; Godot 4.x project file.

config_version=5

[application]

config/name="World Frontier"
config/description="Real-time 3D battlefield: soldiers, insurgents, tanks and air support."
run/main_scene="res://ui/app_root.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://core/event_bus.gd"
Settings="*res://core/settings.gd"
Loc="*res://core/localization.gd"
DB="*res://core/database.gd"
GameState="*res://core/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/default_gravity=9.8
common/physics_ticks_per_second=30

[rendering]

anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.11, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
